# =============================================================================
# Treewiki Environment Configuration
# Copy to .env and adjust. NEVER commit real secrets.
# =============================================================================

# Runtime: development | production (enables HSTS, strict JWT guard)
NODE_ENV=development
ENV=development
PORT=8080
APP_VERSION=1.0.0

# --- Database (PostgreSQL 16+) ----------------------------------------------
# When set, all services persist to PostgreSQL (migrations auto-apply on boot).
# When empty, the gateway runs fully in-memory (development/tests).
DATABASE_URL=postgres://treewiki_admin:treewiki_dev_secret_password@localhost:5432/treewiki_db?sslmode=disable

# --- Auth --------------------------------------------------------------------
# REQUIRED in production (min 32 random chars; boot fails on the dev default).
JWT_SECRET=treewiki_jwt_super_secure_secret_key_change_in_production_2026
JWT_EXPIRATION_HOURS=72

# --- API security -------------------------------------------------------------
# Comma-separated browser origins (no wildcard in production).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Per-IP rate limit: RATE_LIMIT_MAX requests per RATE_LIMIT_WINDOW_SECONDS.
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_SECONDS=60

# --- Social login / OAuth (optional) ---------------------------------------------
# Set a provider's ID + secret to enable its button in the sign-in dialog.
# Register this callback URL in each provider console (replace the host):
#   {OAUTH_REDIRECT_BASE}/api/v1/auth/oauth/{google,github}/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Public gateway base used for OAuth callback URLs (default http://localhost:8080).
OAUTH_REDIRECT_BASE=http://localhost:8080
# Browser base URL the provider flow returns to (default http://localhost:3000).
FRONTEND_URL=http://localhost:3000

# --- Error tracking (optional) ------------------------------------------------
# Sentry-compatible DSN; panics are reported when set, ignored when empty.
SENTRY_DSN=

# --- Web frontend --------------------------------------------------------------
# Public gateway URL baked for browsers; internal URL for SSR fetches.
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
NUXT_API_BASE_INTERNAL=http://localhost:8080/api/v1
# Canonical site URL for SEO tags.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Integration tests ----------------------------------------------------------
# Enables the PostgreSQL integration suite (CI provides this automatically).
TREEWIKI_TEST_DATABASE_URL=

# --- Reserved scale-out services (compose-ready, not required) -------------------
# Search runs as SQL full-text; media persists to local ./uploads volume.
REDIS_URL=redis://localhost:6379/0
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=treewiki-media
S3_ACCESS_KEY=treewiki_minio_user
S3_SECRET_KEY=treewiki_minio_password
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=treewiki_meili_master_key_12345
